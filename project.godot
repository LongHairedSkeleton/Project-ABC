; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=4

_global_script_classes=[ {
"base": "AudioStreamPlayer",
"class": "TextToSpeech",
"language": "GDScript",
"path": "res://addons/texttospeech/TextToSpeech.gd"
}, {
"base": "AudioStreamPlayer2D",
"class": "TextToSpeech2D",
"language": "GDScript",
"path": "res://addons/texttospeech/TextToSpeech2D.gd"
}, {
"base": "AudioStreamPlayer3D",
"class": "TextToSpeech3D",
"language": "GDScript",
"path": "res://addons/texttospeech/TextToSpeech3D.gd"
}, {
"base": "Area2D",
"class": "drag_queen",
"language": "GDScript",
"path": "res://actividades/sorting/dragging_base.gd"
}, {
"base": "Area2D",
"class": "hole",
"language": "GDScript",
"path": "res://actividades/geometry/shape_hole.gd"
}, {
"base": "Control",
"class": "spawner",
"language": "GDScript",
"path": "res://spawner_of_draggables.gd"
} ]
_global_script_class_icons={
"TextToSpeech": "",
"TextToSpeech2D": "",
"TextToSpeech3D": "",
"drag_queen": "",
"hole": "",
"spawner": ""
}

[application]

config/name="EDU Simples"
config/description="Programa designado para ajudar professores dos anos iniciais."
run/main_scene="res://menu.tscn"
boot_splash/show_image=false
boot_splash/bg_color=Color( 0.117647, 0.341176, 0.611765, 1 )
config/icon="res://game_icon.png"
config/windows_native_icon="res://game_icon.ico"

[autoload]

Save="*res://save.gd"
TextToSpeechEngine="*res://addons/texttospeech/TextToSpeechEngine.gd"

[display]

window/size/width=720
window/size/height=1280
window/size/fullscreen=true
window/vsync/use_vsync=false
mouse_cursor/custom_image="res://cursor.png"
window/stretch/mode="viewport"
window/stretch/aspect="keep_height"

[editor_plugins]

enabled=PoolStringArray( "res://addons/texttospeech/plugin.cfg" )

[gui]

common/drop_mouse_on_gui_input_disabled=true
theme/custom="res://base_font_theme.tres"
theme/custom_font="res://base_font_theme.tres"

[physics]

common/enable_pause_aware_picking=true

[rendering]

quality/driver/driver_name="GLES2"
quality/driver/fallback_to_gles2=true
2d/options/use_nvidia_rect_flicker_workaround=true
quality/intended_usage/framebuffer_allocation=0
quality/intended_usage/framebuffer_allocation.mobile=0
vram_compression/import_etc=true
vram_compression/import_etc2=false
environment/default_environment="res://default_env.tres"
