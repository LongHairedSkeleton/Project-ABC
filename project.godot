; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=4

_global_script_classes=[ {
"base": "Area2D",
"class": "drag_queen",
"language": "GDScript",
"path": "res://actividades/sorting/dragging_base.gd"
}, {
"base": "Area2D",
"class": "hole",
"language": "GDScript",
"path": "res://actividades/geometry/shape_hole.gd"
}, {
"base": "Control",
"class": "spawner",
"language": "GDScript",
"path": "res://spawner_of_draggables.gd"
} ]
_global_script_class_icons={
"drag_queen": "",
"hole": "",
"spawner": ""
}

[application]

config/name="EDU Simples"
config/description="Programa designado para ajudar professores dos anos iniciais."
run/main_scene="res://lan/inicial_screen.tscn"
boot_splash/show_image=false
boot_splash/bg_color=Color( 0.117647, 0.341176, 0.611765, 1 )
config/icon="res://game_icon.png"
config/windows_native_icon="res://game_icon.ico"

[autoload]

Save="*res://save.gd"
Lan="*res://lan/networkmanager.gd"
Inputs="*res://inputs.gd"

[display]

window/size/width=900
window/size/height=1440
window/vsync/use_vsync=false
mouse_cursor/custom_image="res://cursor.png"
window/stretch/mode="2d"
window/stretch/aspect="keep_height"

[gui]

common/drop_mouse_on_gui_input_disabled=true
theme/custom="res://base_font_theme.tres"

[input]

resolution+={
"deadzone": 0.5,
"events": [ Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":0,"alt":false,"shift":false,"control":false,"meta":false,"command":false,"pressed":false,"scancode":0,"physical_scancode":61,"unicode":0,"echo":false,"script":null)
 ]
}
